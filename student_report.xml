<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_university_student" model="ir.actions.report">
        <field name="name">Student Summary</field>
        <field name="model">university.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">university_attendance.student_summary_report</field>
        <field name="report_file">university_attendance.student_summary_report</field>
        <field name="print_report_name">'Student Summary - %s' % (object.name)</field>
    </record>

    <template id="student_summary_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Student Summary</h2>
                        <p>Name: <span t-field="doc.name"/></p>
                        <p>Student ID: <span t-field="doc.student_id"/></p>
                        <p>Program: <span t-field="doc.program_id"/></p>
                        <p>Attendance: <span t-field="doc.attendance_percentage"/>%</p>
                        <p>GPA: <span t-field="doc.gpa"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
