<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_low_attendance_warnings" model="ir.cron">
        <field name="name">Generate low attendance warnings</field>
        <field name="model_id" ref="model_university_student"/>
        <field name="state">code</field>
        <field name="code">model._generate_low_attendance_warnings()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
