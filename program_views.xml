<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_program_list" model="ir.ui.view">
        <field name="name">university.program.list</field>
        <field name="model">university.program</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <field name="degree_type"/>
                <field name="duration"/>
            </list>
        </field>
    </record>

    <record id="view_university_program_form" model="ir.ui.view">
        <field name="name">university.program.form</field>
        <field name="model">university.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="degree_type"/>
                            <field name="duration"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
