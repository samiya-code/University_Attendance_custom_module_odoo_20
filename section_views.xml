<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_section_list" model="ir.ui.view">
        <field name="name">university.section.list</field>
        <field name="model">university.section</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="department_id"/>
                <field name="academic_year_id"/>
                <field name="semester_id"/>
                <field name="maximum_students"/>
            </list>
        </field>
    </record>

    <record id="view_university_section_form" model="ir.ui.view">
        <field name="name">university.section.form</field>
        <field name="model">university.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="department_id"/>
                            <field name="program_id"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="semester_id"/>
                            <field name="advisor_id"/>
                            <field name="maximum_students"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
