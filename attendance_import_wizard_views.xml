<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_attendance_import_wizard_form" model="ir.ui.view">
        <field name="name">university.attendance.import.wizard.form</field>
        <field name="model">university.attendance.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Attendance CSV">
                <sheet>
                    <group>
                        <field name="data_file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="import_result" readonly="1" invisible="not import_result"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
