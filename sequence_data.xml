<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_university_student" model="ir.sequence">
        <field name="name">University Student</field>
        <field name="code">university.student</field>
        <field name="prefix">STU</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_university_attendance_session" model="ir.sequence">
        <field name="name">Attendance Session</field>
        <field name="code">university.attendance.session</field>
        <field name="prefix">SES</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_university_academic_warning" model="ir.sequence">
        <field name="name">Academic Warning</field>
        <field name="code">university.academic.warning</field>
        <field name="prefix">WARN</field>
        <field name="padding">5</field>
    </record>
</odoo>
