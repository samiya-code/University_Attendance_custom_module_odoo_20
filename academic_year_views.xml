<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_academic_year_list" model="ir.ui.view">
        <field name="name">university.academic.year.list</field>
        <field name="model">university.academic.year</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_university_academic_year_form" model="ir.ui.view">
        <field name="name">university.academic.year.form</field>
        <field name="model">university.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
