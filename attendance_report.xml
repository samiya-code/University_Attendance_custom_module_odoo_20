<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_university_attendance" model="ir.actions.report">
        <field name="name">Attendance Record</field>
        <field name="model">university.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">university_attendance.attendance_report</field>
        <field name="report_file">university_attendance.attendance_report</field>
        <field name="print_report_name">'Attendance - %s' % (object.student_id.name)</field>
    </record>

    <template id="attendance_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Attendance Record</h2>
                        <p>Student: <span t-field="doc.student_id"/></p>
                        <p>Course: <span t-field="doc.course_id"/></p>
                        <p>Date: <span t-field="doc.date"/></p>
                        <p>Status: <span t-field="doc.status"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
